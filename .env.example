# Oyelearn v3 — server environment
#
# Copy to .env and fill in. NEVER commit a real .env.
# In development every secret below is optional: the server generates and stores dev-only values
# under DATA_DIR (.dev-master-key, .dev-session-secret). In production it refuses to start
# without APP_MASTER_KEY and SESSION_SECRET.

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Persistent volume: SQLite database, proctoring snapshots, nightly backups.
DATA_DIR=/data

# The origin the app is served from, used for cookie and CSP decisions.
PUBLIC_ORIGIN=https://oyelearn.example.com

# 32 bytes, base64 or hex. Encrypts stored AI provider credentials (AES-256-GCM).
# Generate:  openssl rand -base64 32
# If this changes, every saved AI credential becomes unreadable and must be re-entered.
APP_MASTER_KEY=

# 32 bytes, base64 or hex. Generate:  openssl rand -base64 32
SESSION_SECRET=

# First-boot superadmin. If SUPERADMIN_PASSWORD is unset, the server generates a 20-character
# password and prints it to the log exactly once. Either way the account must change its
# password at first login.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=admin

# How long proctoring snapshots are kept before the daily cleanup job deletes them.
SNAPSHOT_RETENTION_DAYS=90

# Dev-only. Runs assessment code in worker_threads instead of isolated-vm. Never set in production.
# DEV_UNSAFE_RUNNER=0
