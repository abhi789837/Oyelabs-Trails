# Oyelearn v3 — server environment
#
# Copy to .env and fill in. NEVER commit a real .env.
# In development every secret below is optional: the server generates and stores dev-only values
# under DATA_DIR (.dev-master-key, .dev-session-secret). In production it refuses to start
# without APP_MASTER_KEY and SESSION_SECRET.

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# Persistent volume: SQLite database, proctoring snapshots, nightly backups.
DATA_DIR=/data

# The origin the app is served from, used for cookie and CSP decisions.
PUBLIC_ORIGIN=https://oyelearn.example.com

# 32 bytes, base64 or hex. Encrypts stored AI provider credentials (AES-256-GCM).
# Generate:  openssl rand -base64 32
# If this changes, every saved AI credential becomes unreadable and must be re-entered.
APP_MASTER_KEY=

# 32 bytes, base64 or hex. Generate:  openssl rand -base64 32
SESSION_SECRET=

# First-boot superadmin. Leave SUPERADMIN_PASSWORD empty: the server then generates a
# 20-character password and prints it to the log exactly once, which is better than a value
# sitting in this file. Set it only if you need a known password for an automated first boot.
# Either way the account must change its password at first login.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=

# Build the image with the claude / codex CLIs installed, for the CLI credential providers.
# An Anthropic or OpenAI API key needs neither and is the recommended path. These are read at
# BUILD time -- change one and rebuild (`docker compose up -d --build`) for it to take effect.
# INSTALL_CLAUDE_CLI=1
# INSTALL_CODEX_CLI=1

# How long one AI call may take before it is abandoned, in milliseconds. Default 900000 (15 min).
# One assessment generation is a dozen or more calls; the CLI providers are much slower than the
# APIs because each call starts a process. This is a safety net against a hung process, not a
# target -- raise it if a slow machine or provider is timing out on work that would have finished.
# AI_TIMEOUT_MS=900000

# How long proctoring snapshots are kept before the daily cleanup job deletes them.
SNAPSHOT_RETENTION_DAYS=90

# Dev-only. Runs assessment code in worker_threads instead of isolated-vm. Never set in production.
# DEV_UNSAFE_RUNNER=0
