{
  "name": "oyelabs-trails",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/content/build-manifest.mjs && node scripts/content/build-server-content.mjs",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "prebuild": "node scripts/content/build-manifest.mjs && node scripts/content/build-server-content.mjs",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "content:check": "node scripts/content/check.mjs",
    "content:types": "tsc -p tsconfig.content.json --noEmit",
    "content:manifest": "node scripts/content/build-manifest.mjs",
    "content:embeds": "node scripts/content/check-embeds.mjs",
    "content:videos": "node scripts/content/check-videos.mjs",
    "pretest": "node scripts/content/build-server-content.mjs",
    "content:server": "node scripts/content/build-server-content.mjs",
    "dev:seed": "tsx server/src/dev/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.9.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "framer-motion": "^13.4.0",
    "isolated-vm": "^7.0.1",
    "lucide-react": "^1.47.0",
    "openai": "^7.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "ulid": "^3.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
